# Required for public/private model endpoints. Generate with: openssl rand -hex 32
DUAL_API_KEY=CHANGE_ME
ALLOW_INSECURE_NO_AUTH=0

# Prefer explicit Kaggle paths after preflight. If omitted, the resolver scans /kaggle/input.
EMBEDDING_MODEL_PATH=
RERANKER_MODEL_PATH=
KAGGLE_INPUT_ROOT=/kaggle/input
ALLOW_REMOTE_MODEL_DOWNLOAD=0

# CPU-safe baseline derived from the proven Qwen3-Embedding-4B runtime.
MODEL_DTYPE=float16
MAX_SEQ_LENGTH=512
EMBEDDING_MICROBATCH_SIZE=1
RERANKER_MICROBATCH_SIZE=1
MAX_CONCURRENT_INFERENCE=1
MAX_QUEUE_WAITERS=32
SECOND_MODEL_MIN_AVAILABLE_GIB=10
FINAL_MIN_AVAILABLE_GIB=4

# Public request limits.
MAX_EMBEDDING_ITEMS=32
MAX_RERANK_DOCUMENTS=20
MAX_TEXT_CHARS=32000
MAX_INSTRUCTION_CHARS=1024
MAX_REQUEST_BYTES=2000000
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
TRUST_PROXY_HEADERS=1

# Runtime.
WARMUP_ENABLED=1
LOAD_MODELS_ON_STARTUP=1
TORCH_NUM_THREADS=0
TORCH_NUM_INTEROP_THREADS=1
RUNTIME_LOCK_PATH=/tmp/qwen3-embedding-reranker-qdrant-stack.lock
SERVER_HOST=127.0.0.1
SERVER_PORT=8000
STARTUP_TIMEOUT_SECONDS=1200

# Quantization is opt-in; the default production profile keeps it disabled.
# Use int8-a8w8 or int8-weight-only only after independent validation.
QUANTIZATION_MODE=none

# GGUF reranker backend (opt-in; source-tree default remains transformers)
RERANKER_BACKEND=transformers
RERANKER_GGUF_PATH=
LLAMA_SERVER_BIN=
LLAMA_SERVER_HOST=127.0.0.1
LLAMA_SERVER_PORT=8081
LLAMA_SERVER_THREADS=2
LLAMA_SERVER_CONTEXT_SIZE=1024
LLAMA_SERVER_STARTUP_TIMEOUT_SECONDS=180

# Production demo / Qdrant (operator-owned)
RETRIEVAL_TOP_K=5
RERANK_TOP_K=5
DISPLAY_TOP_K=5
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=knowledge_entities_qwen3_4b_text_v21
# Leave empty to retrieve exactly K candidates for the explanatory demo.
QDRANT_SCORE_THRESHOLD=
# Kaggle default; stronger hosts may tune after their own qualification.
LLAMA_SERVER_THREADS=2
TORCH_NUM_THREADS=2
